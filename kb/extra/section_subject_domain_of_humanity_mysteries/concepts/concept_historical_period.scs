concept_historical_period
<- sc_node_class;
<- class;

=> nrel_main_idtf:
    [исторический период]
    (* <- lang_ru;; *);

=> nrel_note:
    [Исторический период — промежуток времени в истории человечества,
    с которым связано происхождение, существование или исследование
    объекта тайны.]
    (* <- lang_ru;; *);;